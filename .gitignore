# Secrets - never commit raw secrets
**/*secret*.yaml
**/*secret*.yml
**/*credentials*.yaml
**/*credentials*.yml
**/*creds*.yml

# Allow sealed secrets (safe to commit)
!**/*.sealed.yaml

# Allow templates
!**/*.template*

# Allow specific named files that aren't sensitive
!**/route53-*
!**/externaldns-*

# SOPS / age private keys - NEVER commit
*.age
*.key

# Credential files (Velero and other tool credentials)
credentials-*
*-credentials

# Private architecture diagrams (use Excalidraw externally)
docs/cluster-overview.md

# Talos generated configs: block plaintext, allow partially-encrypted .sops.yaml
talos/clusterconfig/*.yaml
!talos/clusterconfig/*.sops.yaml
!talos/clusterconfig/.gitkeep
.pat

# Session working notes - local only, never tracked
/CONTEXT-*.md
